{
  "rules": {
    "pageViews": {
      ".read": true,
      ".write": true,
      ".validate": "newData.isNumber() && newData.val() >= 0 && (!data.exists() || newData.val() >= data.val())"
    },
    "rooms": {
      "$code": {
        ".read": "$code.matches(/^[A-HJ-NP-Z2-9]{6}$/)",
        ".write": "data.exists() && !newData.exists()",
        "meta": {
          ".write": "!data.exists() && $code.matches(/^[A-HJ-NP-Z2-9]{6}$/)",
          ".validate": "newData.hasChildren(['v', 'seed', 'terrain', 'host', 'createdAt', 'phase0', 'collisions'])",
          "v": { ".validate": "newData.isNumber()" },
          "seed": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4294967295" },
          "terrain": { ".validate": "newData.isString() && newData.val().matches(/^(mixed|normal|spring|summer|autumn|desert|snow)$/)" },
          "host": { ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9]{12}$/)" },
          "createdAt": { ".validate": "newData.val() === now" },
          "phase0": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 1" },
          "collisions": { ".write": "data.exists()", ".validate": "newData.isBoolean()" },
          "$other": { ".validate": false }
        },
        "players": {
          "$seat": {
            ".write": "$seat.matches(/^[0-3]$/) && root.child('rooms/' + $code + '/meta').exists() && (!data.exists() || !newData.exists() || data.child('pid').val() === newData.child('pid').val())",
            ".validate": "newData.hasChildren(['pid', 'name', 'paint', 'joinedAt'])",
            "pid": { ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9]{12}$/)" },
            "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16" },
            "paint": { ".validate": "newData.isString() && newData.val().length <= 20" },
            "joinedAt": { ".validate": "newData.val() === now || newData.val() === data.val()" },
            "$other": { ".validate": false }
          }
        },
        "state": {
          "$seat": {
            ".write": "$seat.matches(/^[0-3]$/) && (!newData.exists() || root.child('rooms/' + $code + '/players/' + $seat).exists())",
            ".validate": "newData.isString() && newData.val().length <= 160"
          }
        },
        "hits": {
          "$seat": {
            ".write": "$seat.matches(/^[0-3]$/) && root.child('rooms/' + $code + '/players/' + $seat).exists()",
            ".validate": "newData.isString() && newData.val().length <= 80"
          }
        },
        "broken": {
          "$id": {
            ".write": "!data.exists() && root.child('rooms/' + $code + '/meta').exists()",
            ".validate": "newData.val() === true && $id.matches(/^[a-z0-9:-]{1,24}$/)"
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
